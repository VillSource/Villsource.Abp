{
  "App": {
    "SelfUrl": "https://localhost:44376",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.Abp.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=workflow;User ID=postgres;Password=mysecretpassword;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44376",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "Abp_Swagger",
    "CertificatePassPhrase": "f14743ca-f5a4-44e7-87f8-660feaceb573"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "XlYdfQzftEpYzsVj"
  }}